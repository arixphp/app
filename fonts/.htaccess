Options -Indexes -MultiViews -ExecCGI -FollowSymLinks
RewriteEngine Off
DirectoryIndex disabled
SetHandler default-handler
<If "%{REQUEST_URI} !~ m#^/(?:[A-Za-z0-9_-]+/)*fonts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:woff|woff2|ttf|otf)$#">
    Require all denied
</If>
<If "%{REQUEST_METHOD} !~ m#^(GET|HEAD)$#">
    Header always set Allow "GET, HEAD"
    Redirect 405 /
</If>
<FilesMatch "(?i)^(?![A-Za-z0-9_-]+\.(?:woff|woff2|ttf|otf)$)">
    Require all denied
</FilesMatch>
AddType font/woff .woff
AddType font/woff2 .woff2
AddType font/ttf .ttf
AddType font/otf .otf
