Options -Indexes -MultiViews -ExecCGI -FollowSymLinks
RewriteEngine Off
DirectoryIndex disabled
SetHandler default-handler
<If "%{REQUEST_URI} !~ m#^/(?:[A-Za-z0-9_-]+/)*media/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:avif|gif|ico|jpg|jpeg|png|webp|mp4|webm|ogv)$#">
    Require all denied
</If>
<If "%{REQUEST_METHOD} !~ m#^(GET|HEAD)$#">
    Header always set Allow "GET, HEAD"
    Redirect 405 /
</If>
<FilesMatch "(?i)^(?![A-Za-z0-9_-]+\.(?:avif|gif|ico|jpg|jpeg|png|webp|mp4|webm|ogv)$)">
    Require all denied
</FilesMatch>
AddType image/avif .avif
AddType image/gif .gif
AddType image/x-icon .ico
AddType image/jpeg .jpg
AddType image/jpeg .jpeg
AddType image/png .png
AddType image/webp .webp
AddType video/mp4 .mp4
AddType video/webm .webm
AddType video/ogg .ogv
