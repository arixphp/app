Options -Indexes -MultiViews -ExecCGI -FollowSymLinks
RewriteEngine Off
DirectoryIndex disabled
SetHandler default-handler
<If "%{REQUEST_URI} !~ m#^/(?:[A-Za-z0-9_-]+/)*styles/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:css)$#">
    Require all denied
</If>
<If "%{REQUEST_METHOD} !~ m#^(GET|HEAD)$#">
    Header always set Allow "GET, HEAD"
    Redirect 405 /
</If>
<FilesMatch "(?i)^(?![A-Za-z0-9_-]+\.(?:css)$)">
    Require all denied
</FilesMatch>
AddType text/css .css
