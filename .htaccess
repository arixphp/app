Options -Indexes -MultiViews
DirectoryIndex index.php

<FilesMatch "(^\.|\.(?:md|ini|log|sqlite|db)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect private files BEFORE the existing-file bypass.
    RewriteRule ^(?:app|core|cli|tests|docs|storage)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^styles/(?![A-Za-z0-9_/-]+\.css$) - [F,L,NC]
    RewriteRule ^scripts/(?![A-Za-z0-9_/-]+\.js$) - [F,L,NC]
    RewriteRule ^assets/(?![A-Za-z0-9_/-]+\.(?:avif|gif|ico|jpe?g|png|webp|mp4|webm|ogv|woff2?|ttf|otf)$) - [F,L,NC]
    RewriteRule ^assets/fonts/(?![A-Za-z0-9_/-]+\.(?:woff2?|ttf|otf)$) - [F,L,NC]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Only explicit public files may bypass the front controller.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(?:index\.php|robots\.txt|favicon\.ico|styles/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:css)|scripts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:js)|assets/(?!(?i:fonts)/)(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:avif|gif|ico|jpe?g|png|webp|mp4|webm|ogv|woff2?|ttf|otf)|assets/fonts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:woff2?|ttf|otf))$ - [L]

    # PHP owns canonical redirects, language negotiation and page methods.
    RewriteRule ^ index.php [L]
</IfModule>
