{
	frankenphp {
		php_ini {
			display_errors Off
			log_errors On
			post_max_size 1M
			upload_max_filesize 1M
		}
	}
}

{$SERVER_NAME:http://127.0.0.1:8181} {
	root * .
	encode zstd br gzip

	header {
		?X-Content-Type-Options nosniff
	}

	header {
		Cache-Control no-cache
		defer
		match {
			header !Cache-Control
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
		}
	}

	request_body {
		max_size 1048576
	}

	route {
		# ARIX ASSET POLICY BEGIN
		@private path_regexp arix_private `(?i)(?:^/(?:app|core|cli|tests|docs|storage)(?:/|$)|^/phpunit\.xml(?:\.dist)?$|(?:^|/)\.)`
		respond @private 403
		@fonts path_regexp arix_fonts `^/assets/fonts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:woff|woff2|ttf|otf)$`
		file_server @fonts {
			pass_thru
		}

		@font_directory path_regexp arix_font_directory `(?i)^/assets/fonts(?:/|$)`
		respond @font_directory 403
		@public_files path_regexp arix_public `^/(?:styles/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:css)|scripts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:js)|assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?i:avif|gif|ico|jpg|jpeg|png|webp|mp4|webm|ogv|woff|woff2|ttf|otf)|favicon\.ico)$`
		file_server @public_files {
			pass_thru
		}

		@public_directories path_regexp arix_public_directories `(?i)^/(?:styles|scripts|assets)(?:/|$)`
		respond @public_directories 403
		@robots {
			path /robots.txt
			file
		}
		file_server @robots
		# ARIX ASSET POLICY END

		# ArixPHP is a front-controller application; never execute another PHP file.
		rewrite * /index.php
		php
	}
}
