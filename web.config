<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files><clear /><add value="index.php" /></files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" />
          <add segment="core" />
          <add segment="cli" />
          <add segment="docs" />
          <add segment="tests" />
          <add segment="storage" />
          <add segment="phpunit.xml" />
          <add segment="phpunit.xml.dist" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".db" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <rewrite>
      <outboundRules>
        <rule name="Revalidate HTML CSS and JavaScript" preCondition="MutableContent">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <preConditions>
          <preCondition name="MutableContent">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^(?:text/html|text/css|(?:text|application)/javascript)(?:;|$)" />
            <add input="{RESPONSE_Cache_Control}" pattern=".+" negate="true" />
          </preCondition>
        </preConditions>
      </outboundRules>
      <rules>
        <rule name="Block non static media assets" stopProcessing="true">
          <match url="^assets/(?![A-Za-z0-9_/-]+\.(?:avif|gif|ico|jpe?g|png|webp|mp4|webm|ogv|woff2?|ttf|otf)$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block non font files in fonts" stopProcessing="true">
          <match url="^assets/fonts/(?![A-Za-z0-9_/-]+\.(?:woff2?|ttf|otf)$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block non CSS styles" stopProcessing="true">
          <match url="^styles/(?![A-Za-z0-9_/-]+\.css$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block non JS scripts" stopProcessing="true">
          <match url="^scripts/(?![A-Za-z0-9_/-]+\.js$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block dot files" stopProcessing="true">
          <match url="(^|/)\." />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block unknown existing files" stopProcessing="true">
          <match url=".*" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{URL}" pattern="^/(?:index\.php|robots\.txt|favicon\.ico|styles/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.css|scripts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.js|assets/(?!(?i:fonts)/)(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?:avif|gif|ico|jpe?g|png|webp|mp4|webm|ogv|woff2?|ttf|otf)|assets/fonts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.(?:woff2?|ttf|otf))$" negate="true" ignoreCase="true" />
          </conditions>
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Arix front controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
